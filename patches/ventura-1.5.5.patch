diff --git a/CompositorTests/VenturaCompatibilityTests.swift b/CompositorTests/VenturaCompatibilityTests.swift
new file mode 100644
index 0000000..53f5ba9
--- /dev/null
+++ b/CompositorTests/VenturaCompatibilityTests.swift
@@ -0,0 +1,123 @@
+import Combine
+import Foundation
+import Testing
+@testable import Compositor
+
+@MainActor
+struct VenturaCompatibilityTests {
+    @Test func replacingOrClosingAnEditStopsForwardingItsChanges() {
+        let session = EditorSession()
+        let first = ColorPickerState(background: false, original: .white)
+        let second = ColorPickerState(background: false, original: .black)
+        session.colorPicker = first
+        var changes = 0
+        let subscription = session.objectWillChange.sink { _ in changes += 1 }
+        defer { subscription.cancel() }
+
+        first.hsb.hue = 30
+        #expect(changes > 0)
+        session.colorPicker = second
+        changes = 0
+        first.hsb.hue = 60
+        #expect(changes == 0)
+        second.hsb.hue = 90
+        #expect(changes > 0)
+        session.colorPicker = nil
+        changes = 0
+        second.hsb.hue = 120
+        #expect(changes == 0)
+    }
+
+    @Test func closingAnEditReleasesIt() {
+        let session = EditorSession()
+        weak var closed: ColorPickerState?
+        do {
+            let picker = ColorPickerState(background: false, original: .white)
+            closed = picker
+            session.colorPicker = picker
+        }
+        session.colorPicker = nil
+        #expect(closed == nil)
+    }
+
+    @Test func historyChangesReachTheEditorMenus() {
+        let session = EditorSession()
+        var changes = 0
+        let subscription = session.objectWillChange.sink { _ in changes += 1 }
+        defer { subscription.cancel() }
+        session.history.markSaved()
+        #expect(changes > 0)
+    }
+
+    @Test func workspaceObservesNewTabsAndReleasesClosedTabs() {
+        let workspace = ProjectWorkspace()
+        let first = workspace.current
+        let second = workspace.addTab(reuseEmpty: false)
+        var changes = 0
+        let subscription = workspace.objectWillChange.sink { _ in changes += 1 }
+        defer { subscription.cancel() }
+        first.session.tool = .brush
+        #expect(changes > 0)
+        changes = 0
+        second.session.tool = .hand
+        #expect(changes > 0)
+        workspace.removeTab(second.id)
+        changes = 0
+        second.session.tool = .move
+        #expect(changes == 0)
+        first.session.tool = .move
+        #expect(changes > 0)
+    }
+
+    @Test func lineStyleAndCapChangesRefreshTheirControls() {
+        let session = EditorSession()
+        var changes = 0
+        let subscription = session.objectWillChange.sink { _ in changes += 1 }
+        defer { subscription.cancel() }
+        session.shapeLineStyle = .dotted
+        #expect(changes > 0)
+        changes = 0
+        session.shapeLineCap = .round
+        #expect(changes > 0)
+    }
+
+    @Test func artboardNamesRefreshTheTabStripAndClosedTabsStopForwarding() {
+        let workspace = ProjectWorkspace()
+        let tab = workspace.addTab(reuseEmpty: false)
+        var changes = 0
+        let subscription = workspace.objectWillChange.sink { _ in changes += 1 }
+        defer { subscription.cancel() }
+        tab.defaultName = "Artboard 1"
+        #expect(tab.title == "Artboard 1")
+        #expect(changes > 0)
+        workspace.removeTab(tab.id)
+        changes = 0
+        tab.defaultName = "Closed artboard"
+        #expect(changes == 0)
+    }
+
+    @Test func changesPreserveOldAndNewValuesWithoutAnInitialCallback() {
+        var state = CompatibleChangeState(10)
+        #expect(state.update(10) == nil)
+        let change = state.update(12)
+        #expect(change?.old == 10)
+        #expect(change?.new == 12)
+        #expect(state.update(12) == nil)
+        #expect(state.update(13)?.old == 12)
+    }
+
+    @Test nonisolated func cameraRawBufferLockSerializesConcurrentAccess() {
+        let value = CompatibleLockedValue(0)
+        DispatchQueue.concurrentPerform(iterations: 2_000) { _ in value.withLock { $0 += 1 } }
+        #expect(value.withLock { $0 } == 2_000)
+    }
+
+    @Test nonisolated func cameraRawBufferLockIsReleasedAfterAnError() throws {
+        enum Failure: Error { case expected }
+        let value = CompatibleLockedValue(0)
+        do {
+            try value.withLock { value in value = 1; throw Failure.expected }
+        } catch Failure.expected { }
+        #expect(value.withLock { $0 } == 1)
+    }
+}
