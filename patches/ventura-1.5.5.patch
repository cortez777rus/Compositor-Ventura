index 0000000..76e8bd3
--- /dev/null
+++ b/docs/third-party-models.md
@@ -0,0 +1,27 @@
+# Bundled third-party model
+
+The macOS 13 foreground-segmentation fallback bundles Apple's compact
+`DeepLabV3Int8LUT.mlmodel` model.
+
+- Source page: <https://developer.apple.com/machine-learning/models/>
+- Direct source URL: <https://ml-assets.apple.com/coreml/models/Image/ImageSegmentation/DeepLabV3/DeepLabV3Int8LUT.mlmodel>
+- Download size: 2,252,685 bytes (about 2.3 MB)
+- Model input: RGB image, 513 × 513 pixels
+- Model output: `semanticPredictions`, a 513 × 513 Int32 class map
+- Model metadata: Pascal VOC-style classes with class `0` reserved for background
+
+The file is kept unchanged in the application source tree and compiled by
+Xcode into `DeepLabV3Int8LUT.mlmodelc`. The model metadata points to the
+TensorFlow and TensorFlow Models repositories for the original model and
+license information; retain this notice whenever redistributing the fork.
+
+There is no runtime download. On macOS 14 and newer the existing Vision
+foreground-instance implementation remains the primary path; this model is
+used only by the legacy compatibility backend and its deterministic fallbacks.
+
+The compatibility implementation is adapted from the MIT-licensed
+[vfxbro/Compositor](https://github.com/vfxbro/Compositor/tree/ca47ed15533786a1d83b08d016ccc952e8501518)
+legacy port. The rest of this port is based on official Compositor v1.5.3.
+
+A copy of the TensorFlow Models Apache 2.0 license is retained in
+`third-party-models-LICENSE.txt`.
diff --git a/scripts/build-ventura.sh b/scripts/build-ventura.sh
new file mode 100755
index 0000000..0efc351
--- /dev/null
+++ b/scripts/build-ventura.sh
@@ -0,0 +1,45 @@
+#!/bin/bash
+# Run with Xcode 26 on a supported build Mac, or through ventura-build.yml.
+set -euo pipefail
+
+cd "$(dirname "$0")/.."
+if [[ "$(uname -s)" != Darwin ]]; then
+    echo "This build needs macOS and Xcode 26. Use the Ventura Build GitHub Actions workflow." >&2
+    exit 1
+fi
+xcode_major=$(xcodebuild -version | awk '/^Xcode / { split($2, v, "."); print v[1] }')
+if [[ -z "$xcode_major" || "$xcode_major" -lt 26 ]]; then
+    echo "Select Xcode 26 or newer. The deployment target is Ventura, but the compiler must support Swift 6.2." >&2
+    exit 1
+fi
+
+output="$PWD/dist/ventura"
+derived="$PWD/build/ventura"
+mkdir -p "$output"
+xcodebuild -resolvePackageDependencies \
+    -project Compositor.xcodeproj -scheme Compositor \
+    -onlyUsePackageVersionsFromResolvedFile \
+    -derivedDataPath "$derived" 2>&1 | tee "$output/packages.log"
+
+xcodebuild build \
+    -project Compositor.xcodeproj -scheme Compositor \
+    -configuration Release -destination 'generic/platform=macOS' \
+    -derivedDataPath "$derived" \
+    -onlyUsePackageVersionsFromResolvedFile \
+    MACOSX_DEPLOYMENT_TARGET=13.0 \
+    ARCHS='arm64 x86_64' ONLY_ACTIVE_ARCH=NO \
+    CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM= \
+    ENABLE_HARDENED_RUNTIME=NO \
+    2>&1 | tee "$output/build.log"
+
+app="$derived/Build/Products/Release/Compositor.app"
+test -d "$app"
+python3 scripts/check-ventura-bundle.py "$app" | tee "$output/bundle-check.txt"
+codesign --verify --deep --strict --verbose=2 "$app" 2>&1 | tee "$output/signature-check.txt"
+python3 scripts/smoke-launch-macos.py "$app" "$output" | tee "$output/launch-check.txt"
+
+version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist")
+archive="$output/Compositor-${version}-Ventura-universal.zip"
+ditto -c -k --sequesterRsrc --keepParent "$app" "$archive"
+shasum -a 256 "$archive" > "$archive.sha256"
+echo "Built: $archive"
diff --git a/scripts/check-ventura-bundle.py b/scripts/check-ventura-bundle.py
new file mode 100755
index 0000000..90d916b
--- /dev/null
+++ b/scripts/check-ventura-bundle.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Reject a bundle whose executable or any embedded Mach-O requires newer macOS."""
+import plistlib
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+MAGIC = {
+    b"\xfe\xed\xfa\xce", b"\xce\xfa\xed\xfe", b"\xfe\xed\xfa\xcf", b"\xcf\xfa\xed\xfe",
+    b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca", b"\xca\xfe\xba\xbf", b"\xbf\xba\xfe\xca",
+}
+
+
+def version(text):
+    parts = tuple(int(part) for part in text.split("."))
+    return parts + (0,) * (3 - len(parts))
+
+
+def check_shortcut_conformances(symbols):
+    # A weak import still crashes if Swift requests its absent witness table. This
+    # caused the 49.0 build to crash in ShortcutSettings.menu on macOS 13.7.8.
+    forbidden = sorted(symbol for symbol in symbols
+                       if re.search(r"SwiftUI(?:13KeyEquivalent|16KeyboardShortcut)V.*Mc$", symbol))
+    assert not forbidden, f"Shortcut protocol conformances unavailable on Ventura: {forbidden}"
+
+
+def inspect(app):
+    info = plistlib.loads((app / "Contents/Info.plist").read_bytes())
+    minimum = info.get("LSMinimumSystemVersion")
+    assert minimum is not None, "LSMinimumSystemVersion is missing"
+    assert version(minimum) <= (13, 0, 0), f"Info.plist requires macOS {minimum}"
+    assert not info.get("SUEnableAutomaticChecks", False), "Official automatic updates must be disabled"
+    assert not info.get("SUFeedURL"), "Official update feed must not replace the Ventura build"
+    assert (app / "Contents/Resources/DeepLabV3Int8LUT.mlmodelc").is_dir(), "Compiled segmentation model is missing"
+    main = (app / "Contents/MacOS" / info["CFBundleExecutable"]).resolve()
+    checked = set()
+    for path in sorted(app.rglob("*")):
+        if not path.is_file() or path.resolve() in checked:
+            continue
+        with path.open("rb") as stream:
+            if stream.read(4) not in MAGIC:
+                continue
+        checked.add(path.resolve())
+        arches = subprocess.check_output(["lipo", "-archs", str(path)], text=True).split()
+        assert {"arm64", "x86_64"} <= set(arches), f"Missing universal slices: {path}: {arches}"
+        for arch in ("arm64", "x86_64"):
+            commands = subprocess.check_output(["otool", "-arch", arch, "-l", str(path)], text=True)
+            versions = re.findall(r"\bminos\s+([\d.]+)", commands)
+            versions += re.findall(r"LC_VERSION_MIN_MACOSX\s+cmdsize\s+\d+\s+version\s+([\d.]+)", commands)
+            assert versions, f"No minimum macOS load command: {path} ({arch})"
+            assert all(version(value) <= (13, 0, 0) for value in versions), f"Requires newer macOS: {path} ({arch}): {versions}"
+            print(f"{path.relative_to(app)}: {arch}, minimum macOS {', '.join(versions)}")
+    assert main in checked, "Main executable was not checked"
+    for arch in ("arm64", "x86_64"):
+        symbols = subprocess.check_output(
+            ["xcrun", "nm", "-arch", arch, "-u", "-j", str(main)], text=True).splitlines()
+        check_shortcut_conformances(symbols)
+        print(f"PASS: {arch} has no imported KeyEquivalent/KeyboardShortcut protocol conformances.")
+    print(f"PASS: {len(checked)} Mach-O files support Intel and Apple Silicon with a minimum OS no newer than 13.0.")
+    print("This checks binary metadata; a launch and feature check on macOS 13.7.8 is still required.")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        sys.exit("Usage: check-ventura-bundle.py /path/to/Compositor.app")
+    inspect(Path(sys.argv[1]).resolve())
diff --git a/scripts/smoke-launch-macos.py b/scripts/smoke-launch-macos.py
new file mode 100644
index 0000000..8202a45
--- /dev/null
+++ b/scripts/smoke-launch-macos.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""Check Release startup on the build host; this does not emulate macOS 13."""
+import platform
+import plistlib
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+app = Path(sys.argv[1]).resolve()
+output = Path(sys.argv[2]).resolve()
+info = plistlib.loads((app / "Contents/Info.plist").read_bytes())
+executable = app / "Contents/MacOS" / info["CFBundleExecutable"]
+print(f"Launch host: macOS {platform.mac_ver()[0]}; app build {info['CFBundleVersion']}", flush=True)
+for arch in ("arm64", "x86_64"):
+    probe = subprocess.run(["/usr/bin/arch", f"-{arch}", "/usr/bin/true"], capture_output=True)
+    if probe.returncode:
+        print(f"SKIP: {arch} cannot run on this host.", flush=True)
+        continue
+    with (output / f"launch-{arch}.log").open("w") as log:
+        process = subprocess.Popen(["/usr/bin/arch", f"-{arch}", str(executable)], stdout=log, stderr=log)
+        try:
+            for _ in range(10):
+                time.sleep(1)
+                assert process.poll() is None, f"{arch} exited during startup: {process.returncode}; see launch-{arch}.log"
+            print(f"PASS: {arch} Release process remained alive through 10 seconds of normal startup.", flush=True)
+        finally:
+            if process.poll() is None:
+                process.terminate()
+                try:
+                    process.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait()
+print("A launch and feature check on the user's macOS 13.7.8 is still required.", flush=True)
