+++ b/.github/workflows/ventura-build.yml
@@ -0,0 +1,91 @@
+name: Ventura Build
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ventura-build-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    runs-on: macos-26
+    timeout-minutes: 60
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Select Xcode 26.6
+        run: sudo xcode-select -s /Applications/Xcode_26.6.app
+
+      - name: Test compatibility and editor behavior
+        run: |
+          set -o pipefail
+          mkdir -p dist/ventura
+          xcodebuild test \
+            -project Compositor.xcodeproj -scheme Compositor \
+            -configuration Debug -destination "platform=macOS,arch=$(uname -m)" \
+            -derivedDataPath build/ventura-tests \
+            -resultBundlePath dist/ventura/Compatibility.xcresult \
+            -onlyUsePackageVersionsFromResolvedFile \
+            -only-testing:CompositorTests/VenturaCompatibilityTests \
+            -only-testing:CompositorTests/VenturaSegmentationTests \
+            -only-testing:CompositorTests/HistoryTests \
+            -only-testing:CompositorTests/CommandPaletteTests \
+            -only-testing:CompositorTests/KeyboardShortcutTests \
+            -only-testing:CompositorTests/ProjectWorkspaceTests \
+            -only-testing:CompositorTests/CameraRawGPUTests \
+            -only-testing:CompositorTests/GPUCanvasTests \
+            -only-testing:CompositorTests/AdjustmentLayerTests \
+            -only-testing:CompositorTests/ChannelPackTests \
+            -only-testing:CompositorTests/FilterLayerTests \
+            -only-testing:CompositorTests/FilterTests \
+            -only-testing:CompositorTests/FontMenuFacesTests \
+            -only-testing:CompositorTests/PDFImportTests \
+            -only-testing:CompositorTests/PSDArtboardTests \
+            -only-testing:CompositorTests/PenPressureTests \
+            -only-testing:CompositorTests/ShapeToolTests \
+            -only-testing:CompositorTests/ProjectTests \
+            -only-testing:CompositorTests/CompositorTests \
+            -only-testing:CompositorTests/FloatingPanelTests \
+            MACOSX_DEPLOYMENT_TARGET=13.0 ONLY_ACTIVE_ARCH=YES \
+            CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM= \
+            GCC_OPTIMIZATION_LEVEL=s SWIFT_OPTIMIZATION_LEVEL=-O \
+            2>&1 | tee dist/ventura/tests.log
+
+      - name: Export test summary
+        if: always()
+        run: |
+          if [ -d dist/ventura/Compatibility.xcresult ]; then
+            xcrun xcresulttool get test-results summary --path dist/ventura/Compatibility.xcresult \
+              | tee dist/ventura/test-summary.json
+          fi
+
+      - name: Build universal Ventura application
+        run: bash scripts/build-ventura.sh
+
+      - name: Upload application
+        uses: actions/upload-artifact@v7
+        with:
+          name: Compositor-1.5.5-Ventura-universal
+          path: |
+            dist/ventura/*.zip
+            dist/ventura/*.sha256
+          if-no-files-found: error
+          retention-days: 30
+
+      - name: Upload build and test evidence
+        if: always()
+        uses: actions/upload-artifact@v7
+        with:
+          name: Ventura-build-diagnostics
+          path: |
+            dist/ventura/*.log
+            dist/ventura/*.txt
+            dist/ventura/*.json
+            dist/ventura/*.xcresult
+          if-no-files-found: ignore
+          retention-days: 14
