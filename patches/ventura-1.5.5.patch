@@ -0,0 +1,99 @@
+import CoreGraphics
+import CoreML
+import CoreVideo
+import Foundation
+import Testing
+@testable import Compositor
+
+struct VenturaSegmentationTests {
+    @Test func bundledModelCanLoadForVenturaBackend() throws {
+        let url = try #require(Bundle.main.url(forResource: "DeepLabV3Int8LUT", withExtension: "mlmodelc"))
+        let configuration = MLModelConfiguration()
+        configuration.computeUnits = .cpuOnly
+        let model = try MLModel(contentsOf: url, configuration: configuration)
+        #expect(model.modelDescription.inputDescriptionsByName.values.contains { $0.type == .image })
+        #expect(model.modelDescription.outputDescriptionsByName.values.contains { $0.type == .multiArray })
+    }
+
+    @Test func connectedComponentDoesNotIncludeASeparateObject() throws {
+        let pixels: [UInt8] = [
+            255, 255, 0, 0, 0,
+            255,   0, 0, 0, 0,
+              0,   0, 0, 0, 255,
+              0,   0, 0, 0, 255,
+        ]
+        let selected = try #require(ForegroundMaskUtilities.connectedComponent(
+            in: pixels, width: 5, height: 4, at: CGPoint(x: 0, y: 0)))
+        #expect(selected.filter { $0 != 0 }.count == 3)
+        #expect(selected[2 * 5 + 4] == 0)
+        #expect(ForegroundMaskUtilities.connectedComponent(
+            in: pixels, width: 5, height: 4, at: CGPoint(x: 3, y: 0)) == nil)
+    }
+
+    @Test func asymmetricMaskRoundTripPreservesEveryRow() throws {
+        let pixels: [UInt8] = [255, 0, 0, 0, 128, 0, 0, 0, 0, 0, 0, 64]
+        let image = try ForegroundMaskUtilities.cgImage(from: pixels, width: 3, height: 4)
+        let result = try ForegroundMaskUtilities.grayscaleBytes(from: image, width: 3, height: 4)
+        #expect(result == pixels)
+    }
+
+    @Test func closingFillsAnInteriorPinHole() {
+        var pixels = [UInt8](repeating: 0, count: 9 * 9)
+        for y in 2..<7 { for x in 2..<7 { pixels[y * 9 + x] = 255 } }
+        pixels[4 * 9 + 4] = 0
+        let closed = ForegroundMaskUtilities.closed(pixels, width: 9, height: 9)
+        #expect(closed[4 * 9 + 4] == 255)
+        #expect(closed[0] == 0)
+    }
+
+    @Test func scaledMaskPreservesCornersAndIntermediateValues() throws {
+        let pixels: [UInt8] = [255, 0, 0, 0, 128, 0, 0, 0, 0, 0, 0, 64]
+        let image = try ForegroundMaskUtilities.cgImage(from: pixels, width: 3, height: 4)
+        let result = try ForegroundMaskUtilities.grayscaleBytes(from: image, width: 6, height: 8)
+        for y in 0..<8 {
+            for x in 0..<6 {
+                #expect(result[y * 6 + x] == pixels[(y / 2) * 3 + x / 2])
+            }
+        }
+        let smooth = try ForegroundMaskUtilities.grayscaleBytes(from: image, width: 6, height: 8, interpolation: .high)
+        #expect(smooth[0] == 255)
+        #expect(smooth[47] == 64)
+    }
+
+    @Test func colorSamplingPreservesAllFourCornersOfAnOddWidthImage() throws {
+        let width = 3, height = 4
+        var pixels = [UInt8](repeating: 0, count: width * height * 4)
+        for offset in stride(from: 3, to: pixels.count, by: 4) { pixels[offset] = 255 }
+        pixels[0] = 255
+        pixels[2 * 4 + 1] = 255
+        pixels[9 * 4 + 2] = 255
+        pixels[11 * 4] = 255
+        pixels[11 * 4 + 1] = 255
+        pixels[11 * 4 + 2] = 255
+        let provider = try #require(CGDataProvider(data: Data(pixels) as CFData))
+        let image = try #require(CGImage(width: width, height: height, bitsPerComponent: 8,
+            bitsPerPixel: 32, bytesPerRow: width * 4, space: CGColorSpace(name: CGColorSpace.sRGB)!,
+            bitmapInfo: CGBitmapInfo(rawValue: CGImageAlphaInfo.premultipliedLast.rawValue |
+                CGBitmapInfo.byteOrder32Big.rawValue), provider: provider, decode: nil,
+            shouldInterpolate: false, intent: .defaultIntent))
+        #expect(try ForegroundMaskUtilities.rgbaBytes(from: image, width: width, height: height) == pixels)
+    }
+
+    @Test func modelInputKeepsTopAndBottomRowsInTheirOriginalPositions() throws {
+        let pixels: [UInt8] = [255, 0, 0, 255, 0, 255, 0, 255,
+                                0, 0, 255, 255, 255, 255, 255, 255]
+        let provider = try #require(CGDataProvider(data: Data(pixels) as CFData))
+        let image = try #require(CGImage(width: 2, height: 2, bitsPerComponent: 8,
+            bitsPerPixel: 32, bytesPerRow: 8, space: CGColorSpace(name: CGColorSpace.sRGB)!,
+            bitmapInfo: CGBitmapInfo(rawValue: CGImageAlphaInfo.premultipliedLast.rawValue |
+                CGBitmapInfo.byteOrder32Big.rawValue), provider: provider, decode: nil,
+            shouldInterpolate: false, intent: .defaultIntent))
+        let buffer = try LegacyForegroundSegmentationBackend.pixelBuffer(from: image, size: 2)
+        CVPixelBufferLockBaseAddress(buffer, .readOnly)
+        defer { CVPixelBufferUnlockBaseAddress(buffer, .readOnly) }
+        let data = try #require(CVPixelBufferGetBaseAddress(buffer)).assumingMemoryBound(to: UInt8.self)
+        let stride = CVPixelBufferGetBytesPerRow(buffer)
+        #expect(Array(UnsafeBufferPointer(start: data, count: 8)) == [0, 0, 255, 255, 0, 255, 0, 255])
+        #expect(Array(UnsafeBufferPointer(start: data + stride, count: 8)) == [255, 0, 0, 255, 255, 255, 255, 255])
+    }
+}
