+
+// Keep the AppKit subclass outside the generic representable. Swift 6.3.3
+// crashes while optimizing the generic subclass's deinitializer for macOS 13.
+final class IndicatorlessScrollContainer: NSScrollView {
+    let host: NSHostingView<AnyView>
+
+    init(rootView: AnyView) {
+        host = NSHostingView(rootView: rootView)
+        super.init(frame: .zero)
+        drawsBackground = false
+        borderType = .noBorder
+        hasVerticalScroller = false
+        hasHorizontalScroller = false
+        horizontalScrollElasticity = .none
+        documentView = host
+        updateDocumentSize()
+    }
+
+    required init?(coder: NSCoder) { nil }
+
+    override func layout() {
+        super.layout()
+        updateDocumentSize()
+    }
+
+    func updateDocumentSize() {
+        let height = host.fittingSize.height
+        let size = NSSize(width: 56, height: height)
+        if host.frame.size != size { host.setFrameSize(size) }
+        verticalScrollElasticity = height > contentView.bounds.height + 1 ? .allowed : .none
     }
 }
